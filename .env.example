# Influencor web — copier en .env (jamais versionné).
#
# Domaines : gérés à chaud, sans redémarrage, par
#   ./start.sh --domain-add <domaine>   ./start.sh --domain-remove <domaine>   ./start.sh --domains
# (liste dans nginx/sites/domains.list). influencor.mi-kandra.org sert le site vitrine
# (dépôt influencor-web) et est refusé.
#
# Ancien réglage, lu une seule fois pour amorcer la liste de domaines s'il est renseigné.
INFLUENCOR_DOMAIN=

# Let's Encrypt (certificat émis automatiquement à l'ajout d'un domaine).
# Adresse pour les alertes d'expiration (recommandé ; vide = aucune adresse enregistrée).
LETSENCRYPT_EMAIL=
# 1 = autorité de test Let's Encrypt (certificats NON reconnus, pour essayer sans quota).
LETSENCRYPT_STAGING=0

# Certificat manuel (Cloudflare « Origin Certificate »…), prioritaire sur Let's Encrypt :
#   nginx/certs/<domaine>/fullchain.pem + privkey.pem
# Ancien emplacement unique, encore accepté pour les domaines qu'il couvre :
SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
SSL_KEY_PATH=/etc/nginx/certs/privkey.pem

# ── Degany, l'assistant IA de l'app ──────────────────────────────────────────
# Lu au moment du build de l'app (pas par le serveur web) :
#   flutter run --dart-define-from-file=.env
#   tools/build_*_release.ps1 le passent tout seuls quand .env existe.
# Les builds web ne le reçoivent PAS : la clé serait lisible par tout visiteur
# du site. Même dans un APK / EXE, la clé reste extractible : utilisez une clé
# dédiée, avec un plafond de dépenses chez le fournisseur.
#
# true  = chaque utilisateur choisit son fournisseur, sa clé et son modèle dans
#         les réglages de Degany (comportement actuel). Le modèle ci-dessous
#         sert tant qu'il n'a rien configuré.
# false = ces réglages sont masqués : Degany utilise toujours le modèle
#         ci-dessous.
DEGANY_USER_MODELS=true
# openai, anthropic, gemini, deepseek, mistral, xai, groq, openrouter, qwen,
# ollama ou custom. Vide = aucun modèle fourni par l'app.
DEGANY_PROVIDER=
# Vide = modèle par défaut du fournisseur.
DEGANY_MODEL=
DEGANY_API_KEY=
# Vide = adresse par défaut du fournisseur (obligatoire pour custom).
DEGANY_BASE_URL=
