# =============================================================================
# Vhost Influencor (build web Flutter) — nginx d'origine Mi Kandra.
#
# Syntaxe envsubst : ${VAR} est remplacé au démarrage, seulement pour les noms
# filtrés par NGINX_ENVSUBST_FILTER (INFLUENCOR_*, SSL_*). Les variables Nginx
# ($host, $uri…) s'écrivent donc normalement, avec un seul $.
#
# Les domaines servis ne sont PAS ici : un fichier par domaine dans
# /etc/nginx/sites/ (nginx/sites/ sur l'hôte), généré par
#   ./start.sh --domain-add <domaine>  /  --domain-remove <domaine>
# puis pris en compte par un simple `nginx -s reload` (aucun redémarrage).
# =============================================================================

# IP client réelle : derrière le routeur partagé (:8443, PROXY protocol) et/ou
# derrière le proxy Cloudflare (nuage orange).
include /etc/nginx/snippets/mi-kandra-realip.conf;
include /etc/nginx/snippets/mi-kandra-cloudflare.conf;

# Plusieurs domaines, parfois longs : la valeur par défaut (32/64) fait échouer nginx -t.
server_names_hash_bucket_size 128;

# Host inconnu / scan direct de l'IP : on coupe, sans rien révéler.
server {
    listen 80 default_server;
    include /etc/nginx/snippets/mi-kandra-listen-http-default.conf;
    server_name _;

    # Healthcheck Docker (local au conteneur).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok
";
    }
    location / { return 444; }
}

server {
    listen 443 ssl default_server;
    include /etc/nginx/snippets/mi-kandra-listen-tls-default.conf;
    server_name _;
    ssl_reject_handshake on;
}

# Un fichier par domaine (vide au premier démarrage : seuls les serveurs par défaut répondent).
include /etc/nginx/sites/*.conf;
