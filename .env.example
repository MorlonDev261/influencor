# Influencor web — copier en .env (jamais versionné).
#
# Domaines : gérés à chaud, sans redémarrage, par
#   ./start.sh --domain-add <domaine>   ./start.sh --domain-remove <domaine>   ./start.sh --domains
# (liste dans nginx/sites/domains.list). influencor.mi-kandra.org sert le site vitrine
# (dépôt influencor-web) et est refusé.
#
# Ancien réglage, lu une seule fois pour amorcer la liste de domaines s'il est renseigné.
INFLUENCOR_DOMAIN=

# Let's Encrypt (certificat émis automatiquement à l'ajout d'un domaine).
# Adresse pour les alertes d'expiration (recommandé ; vide = aucune adresse enregistrée).
LETSENCRYPT_EMAIL=
# 1 = autorité de test Let's Encrypt (certificats NON reconnus, pour essayer sans quota).
LETSENCRYPT_STAGING=0

# Certificat manuel (Cloudflare « Origin Certificate »…), prioritaire sur Let's Encrypt :
#   nginx/certs/<domaine>/fullchain.pem + privkey.pem
# Ancien emplacement unique, encore accepté pour les domaines qu'il couvre :
SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
SSL_KEY_PATH=/etc/nginx/certs/privkey.pem
