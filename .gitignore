# Windows
**/windows/flutter/generated_plugin_registrant.*
**/windows/flutter/generated_plugins.cmake

# Local secrets
*.env
.env*
# Réglages du projet (nom, ports de diagnostic), sans secret : lu par start.sh, doit être versionné.
!/scripts/edge/project.env

# Local release artifacts collected by tools/collect_release_artifacts.ps1
/dist/latest/**
/dist/releases/**
!/dist/README.md
!/dist/.gitkeep

# Vidéos de présentation : trop lourdes pour git, gardées en local
/docs/video/

# Local scratch (screenshots, logs, backups) and compiler output
/tmp/
*.obj

# Firebase client config: downloaded per developer from the console
**/android/app/google-services.json

!.env.example
/nginx/certs/*
!/nginx/certs/.gitkeep
# Générés par start.sh (domaines, Let's Encrypt)
/nginx/sites/
/nginx/letsencrypt/
/nginx/acme/
# Choix de cohabitation Mi Kandra (scripts/edge), propre à ce serveur.
.mi-kandra-edge.pref
